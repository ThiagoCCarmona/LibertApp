<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibertApp.Mobile.MainPage"
             BackgroundColor="#FDFBF7"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!--
            Carrega a versao de producao publicada na VPS (em vez do bundle local em
            Resources/Raw/wwwroot), garantindo que o app sempre reflita o site publicado
            sem precisar de um novo build/release. A ponte JS<->C# (HybridBridge) e
            preservada via esquema de URL customizado interceptado em OnNavigating.
        -->
        <WebView x:Name="webView"
                 Source="https://libertapp.tccodes.com.br"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />
    </Grid>

</ContentPage>
