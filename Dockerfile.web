# Build stage: Node.js para compilar os assets estáticos do Vite
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Production stage: Nginx Alpine ultraleve
FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

# Copia build estático do Vite
COPY --from=build /app/dist .

# Copia configuração do Nginx com fallback SPA e proxy reverso para a API
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
